# ============================================================================
# AGENTIC AI PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================
# IMPORTANT: This file contains sensitive credentials
# - Never commit this file to version control
# - Use strong, unique passwords for production
# - Rotate secrets regularly (every 90 days minimum)
# ============================================================================

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=agentic-ai-platform
APP_VERSION=1.3.0

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=agenticbase2
DB_USER=postgres
DB_PASSWORD=postgres

# Connection Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Cache Settings
CACHE_DEFAULT_TTL=300

# ----------------------------------------------------------------------------
# Keycloak Configuration
# ----------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=agentic
KEYCLOAK_CLIENT_ID=agentic-api
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here_change_in_production
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# ----------------------------------------------------------------------------
# LLM Provider Configuration
# ----------------------------------------------------------------------------
# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
LLM_DEFAULT_PROVIDER=ollama

# OpenAI (Optional)
OPENAI_API_KEY=

# Anthropic (Optional)
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Application Security
# ----------------------------------------------------------------------------
# IMPORTANT: Generate strong random keys for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-replace-in-production-min-32-characters
JWT_SECRET_KEY=dev-jwt-secret-key-replace-in-production-min-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------------------------------------------------------------------
# Email Configuration (Optional)
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@agenticai.com

# ----------------------------------------------------------------------------
# Secrets Management Configuration
# ----------------------------------------------------------------------------
SECRETS_PROVIDER=local
SECRETS_CACHE_TTL=300
SECRETS_ENV_FILE=.env
SECRETS_AUDIT_LOG=logs/secrets_audit.log
# SECRETS_MASTER_KEY=  # Optional: for encryption at rest

# Vault Configuration (for production)
# VAULT_ADDR=https://vault.production.yourcompany.com
# VAULT_TOKEN=your_vault_token_here
# VAULT_NAMESPACE=agentic-ai-platform/production
# VAULT_MOUNT_POINT=secret

# AWS Secrets Manager (alternative for production)
# AWS_REGION=us-east-1
# AWS_SECRETS_PREFIX=agentic-ai-platform/production

# ----------------------------------------------------------------------------
# Monitoring & Observability
# ----------------------------------------------------------------------------
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Sentry (Optional)
SENTRY_DSN=

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ----------------------------------------------------------------------------
# CORS Configuration
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000,http://localhost:5173,http://localhost:8501"]

# ----------------------------------------------------------------------------
# Development/Testing
# ----------------------------------------------------------------------------
AUTO_RELOAD=true
TEST_DB_URL=
TEST_KEYCLOAK_ENABLED=false
TEST_MOCK_LLM=true



SECRETS_MASTER_KEY=XZ12Sed-8MlGeA3GcalB8CgufRWA4eCjniZkaDXFLrc=